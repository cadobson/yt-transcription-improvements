{
  "manifest_version": 3,
  "name": "Transcript Helper",
  "version": "0.0.1",
  "description": "Better search and Ctrl+F behaviour for YouTube's video transcript panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "transcript-helper@christopherdobson.dev",
      "strict_min_version": "140.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
